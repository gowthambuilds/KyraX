# ==========================================
# KYRA X - DISCORD BOT CONFIGURATION
# ==========================================

# Discord Bot Credentials
# Get these from the Discord Developer Portal: https://discord.com/developers/applications
TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_bot_client_id_here

# Bot Settings
PREFIX=+
OWNER_ID=your_discord_user_id_here
# Optional: Multiple owner IDs separated by commas (e.g. 123456789012345678,987654321098765432)
# OWNER_IDS=your_discord_user_id_here

# Database Configuration
# MongoDB Connection String (e.g. MongoDB Atlas or local instance)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/kyrax?retryWrites=true&w=majority

# AI Features (Optional - for AI channel & AI server builder)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_KEY=your_openrouter_api_key_here

# Spotify API Configuration (for Spotify song resolution in Music module)
# Get these from Spotify Developer Dashboard: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
